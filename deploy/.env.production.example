API_DOMAIN=api.example.com
API_ENV=production
API_UPLOAD_DIR=/app/uploaded_docs
API_DATABASE_PATH=/app/data/api.sqlite3
API_CORS_ORIGINS=https://servicewechat.com
API_JWT_SECRET=replace-with-a-long-random-secret
WECHAT_APPID=replace-with-your-appid
WECHAT_APPSECRET=replace-with-your-appsecret
WECHAT_ADMIN_OPENIDS=replace-with-admin-openid
# RAG/讯飞配置。值请在云托管控制台直接填写，不要提交到 Git。
XF_APPID=replace-with-xfyun-appid
XF_APIKEY=replace-with-xfyun-apikey
XF_APISECRET=replace-with-xfyun-apisecret
