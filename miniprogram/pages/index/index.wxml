<view class="page">
  <view class="topbar">
    <view class="brand-mark"><view class="brand-icon">知</view><view><text class="brand-name">知答库</text><text class="brand-caption">企业知识工作台</text></view></view>
    <text class="role">{{isAdmin ? '管理员' : '成员'}}</text>
  </view>

  <view class="welcome">
    <text class="eyebrow">KNOWLEDGE WORKSPACE</text>
    <text class="title">从企业资料中找到可信答案</text>
    <text class="welcome-copy">资料、问答和引用来源集中在一个工作台里。</text>
  </view>

  <view class="composer section-block">
    <view class="section-head"><view><text class="section-title">向知识库提问</text><text class="section-note">答案会附带资料来源</text></view><text class="question-mark">?</text></view>
    <textarea class="question" maxlength="1000" placeholder="例如：报销申请需要哪些材料？" value="{{question}}" bindinput="onQuestionInput"></textarea>
    <view class="suggestion"><text>试试：</text><text>报销流程</text><text>员工手册</text><text>请假规则</text></view>
    <button class="ask" loading="{{loading}}" disabled="{{loading}}" bindtap="askQuestion">{{loading ? '检索中...' : '开始问答'}}</button>
  </view>

  <view class="shortcuts">
    <view wx:if="{{isAdmin}}" class="shortcut shortcut-primary" bindtap="chooseFile"><view class="shortcut-icon">+</view><view><text class="shortcut-title">上传资料</text><text class="shortcut-note">TXT / PDF / DOCX</text></view><text class="shortcut-arrow">></text></view>
    <view class="shortcut" bindtap="openDocuments"><view class="shortcut-icon">≡</view><view><text class="shortcut-title">资料管理</text><text class="shortcut-note">{{documentCount}} 份资料 · {{chunkCount}} 个片段</text></view><text class="shortcut-arrow">></text></view>
  </view>

  <view class="stats">
    <view class="stat"><text class="stat-number">{{documentCount}}</text><text class="stat-label">资料</text></view>
    <view class="stat"><text class="stat-number">{{chunkCount}}</text><text class="stat-label">知识片段</text></view>
    <view class="stat"><text class="stat-number">{{questionCount}}</text><text class="stat-label">本次提问</text></view>
  </view>

  <view wx:if="{{overviewError}}" class="error" bindtap="loadOverview"><text>{{overviewError}}</text><text class="error-action">点击重试</text></view>

  <view class="section-block recent">
    <view class="section-head"><view><text class="section-title">最近资料</text><text class="section-note">用于回答的知识来源</text></view><text class="view-all" bindtap="openDocuments">查看全部</text></view>
    <view wx:for="{{documents}}" wx:key="id" class="document-row"><view class="file-icon">DOC</view><view class="document-main"><text class="document-name">{{item.name}}</text><text class="document-meta">{{item.chunks}} 个知识片段</text></view><text class="row-arrow">></text></view>
    <view wx:if="{{!documents.length && !overviewError}}" class="empty"><view class="empty-icon">+</view><text class="empty-title">还没有资料</text><text class="empty-copy">上传企业资料后，就可以开始提问</text><button wx:if="{{isAdmin}}" class="empty-button" bindtap="chooseFile">上传第一份资料</button></view>
  </view>

  <view wx:if="{{answer}}" class="section-block answer-block"><view class="section-head"><view><text class="section-title">回答</text><text class="section-note">基于当前知识库检索</text></view><text class="answer-badge">已完成</text></view><text class="answer">{{answer}}</text><view wx:if="{{sources.length}}" class="sources"><text class="sources-title">参考资料</text><view wx:for="{{sources}}" wx:key="index" class="source"><view class="source-meta"><text class="source-name">{{item.name}}</text><text wx:if="{{item.page}}" class="source-page">第 {{item.page }} 页</text></view><text class="source-content">{{item.content}}</text></view></view></view>
</view>
