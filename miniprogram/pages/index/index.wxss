.page{min-height:100vh;background:#f7f9fa;padding:48rpx 32rpx;box-sizing:border-box;color:#1f2937}.hero{padding:24rpx 8rpx 40rpx}.eyebrow{display:block;color:#0f766e;font-size:20rpx;letter-spacing:3rpx}.title{display:block;font-size:56rpx;font-weight:700;margin-top:12rpx}.subtitle{display:block;color:#64748b;font-size:27rpx;margin-top:10rpx}.stats,.panel{background:#fff;border-radius:16rpx;padding:28rpx;margin-bottom:24rpx;box-sizing:border-box}.stats{display:flex;justify-content:space-around;text-align:center}.number{display:block;font-size:38rpx;font-weight:700;color:#0f766e}.label{color:#94a3b8;font-size:23rpx}.panel-title{display:block;font-size:31rpx;font-weight:700;margin-bottom:22rpx}.question{width:100%;min-height:180rpx;background:#f8fafc;padding:20rpx;box-sizing:border-box;border-radius:12rpx;font-size:28rpx}.ask{margin-top:22rpx;background:#0f766e;color:#fff;border-radius:10rpx}.answer{display:block;line-height:1.7;font-size:29rpx}
