.page{min-height:100vh;background:#f7f9fa;padding:34rpx 30rpx 56rpx;box-sizing:border-box;color:#1f2937}
.heading-row{display:flex;justify-content:space-between;align-items:flex-start;gap:20rpx;margin-bottom:26rpx}
.heading{font-size:46rpx;font-weight:700;color:#173c3a}
.sub{font-size:24rpx;color:#718087;line-height:1.5;margin-top:9rpx}
.rebuild{display:flex;align-items:center;justify-content:center;text-align:center;margin:0;padding:0 18rpx;height:62rpx;line-height:1;background:#fff;color:#0f766e;border:1rpx solid #a9d8d2;border-radius:12rpx;font-size:22rpx;white-space:nowrap}
.error{display:flex;padding:18rpx 20rpx;margin-bottom:18rpx;background:#fff3f2;border:1rpx solid #f4c7c2;color:#b91c1c;border-radius:12rpx;font-size:23rpx;line-height:1.5}
.upload-panel{background:#effaf8;border:1rpx solid #c4e5e0;border-radius:16rpx;padding:24rpx;margin-bottom:22rpx}
.upload-panel-top{display:flex;align-items:center}
.upload-symbol{width:58rpx;height:58rpx;display:flex;align-items:center;justify-content:center;background:#d4f0ec;color:#0f766e;border-radius:14rpx;font-size:34rpx;margin-right:16rpx}
.upload-copy{min-width:0}.upload-title{display:block;color:#1f4d48;font-size:28rpx;font-weight:700}.upload-note{display:block;color:#6e8783;font-size:22rpx;margin-top:6rpx}
.upload-rule{display:flex;justify-content:space-between;gap:18rpx;margin-top:20rpx;color:#6e8783;font-size:21rpx}
.upload{display:flex;align-items:center;justify-content:center;text-align:center;height:76rpx;line-height:1;margin-top:20rpx;background:#0f766e;color:#fff;border-radius:11rpx;font-size:26rpx}
.upload[disabled]{background:#92bdb8}
.progress-panel{background:#fff;border:1rpx solid #e4ebed;border-radius:14rpx;padding:20rpx 22rpx;margin-bottom:20rpx}
.progress-label{display:flex;justify-content:space-between;color:#53666b;font-size:23rpx;margin-bottom:13rpx}
.list-head{display:flex;justify-content:space-between;align-items:flex-end;margin:12rpx 4rpx 12rpx}
.list-title{display:block;color:#26383d;font-size:29rpx;font-weight:700}.list-note{display:block;color:#95a2a7;font-size:21rpx;margin-top:5rpx}
.item{display:flex;align-items:center;gap:14rpx;background:#fff;border:1rpx solid #e4ebed;border-radius:14rpx;padding:20rpx;margin-bottom:12rpx}
.file-badge{width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;flex:0 0 auto;background:#e8f5f3;color:#0f766e;border-radius:10rpx;font-size:15rpx;font-weight:700}
.item-main{min-width:0;flex:1}.name{font-size:27rpx;color:#33454a;word-break:break-all}.meta{margin-top:6rpx;color:#94a1a6;font-size:21rpx}
.delete{display:flex;align-items:center;justify-content:center;text-align:center;flex:0 0 auto;color:#b91c1c;background:#fff;font-size:22rpx;padding:0 8rpx}
.empty{text-align:center;padding:60rpx 18rpx;background:#fff;border:1rpx dashed #c9d9d9;border-radius:14rpx}
.empty-symbol{width:58rpx;height:58rpx;display:flex;align-items:center;justify-content:center;margin:0 auto 12rpx;background:#edf7f5;color:#0f766e;border-radius:50%;font-size:32rpx}
.empty-title{display:block;color:#53666b;font-size:26rpx;font-weight:600}.empty-copy{display:block;color:#98a5aa;font-size:22rpx;margin-top:7rpx}
.empty-action{display:flex;align-items:center;justify-content:center;text-align:center;height:68rpx;line-height:1;margin:18rpx auto 0;background:#fff;color:#0f766e;border:1rpx solid #a9d8d2;border-radius:10rpx;font-size:24rpx}
