.page{min-height:100vh;background:#f7f9fa;padding:40rpx 32rpx;box-sizing:border-box}.heading-row{display:flex;justify-content:space-between;align-items:flex-start;gap:20rpx}.heading{font-size:48rpx;font-weight:700;color:#1f2937}.sub{font-size:26rpx;color:#64748b;margin:12rpx 0 28rpx}.rebuild{margin:0;padding:0 20rpx;height:64rpx;line-height:64rpx;background:#fff;color:#0f766e;border:1rpx solid #99f6e4;border-radius:10rpx;font-size:24rpx;white-space:nowrap}.error{padding:18rpx 20rpx;margin-bottom:18rpx;background:#fef2f2;color:#b91c1c;border-radius:10rpx;font-size:25rpx;line-height:1.5}.progress-panel{background:#fff;padding:22rpx 24rpx;margin-bottom:18rpx;border-radius:12rpx}.progress-label{font-size:25rpx;color:#475569;margin-bottom:14rpx}.item{background:#fff;border-radius:14rpx;padding:28rpx;margin-bottom:18rpx;display:flex;justify-content:space-between;align-items:center;gap:20rpx}.item-main{min-width:0}.name{font-size:30rpx;color:#1f2937;word-break:break-all}.meta{margin-top:8rpx;color:#94a3b8;font-size:24rpx}.delete{flex:0 0 auto;color:#dc2626;background:#fff;font-size:25rpx;padding:0 8rpx}.upload{margin-top:30rpx;background:#0f766e;color:#fff;border-radius:10rpx}.empty{text-align:center;color:#94a3b8;padding:80rpx 0}
