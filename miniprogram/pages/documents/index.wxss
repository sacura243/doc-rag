.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 34rpx 30rpx 56rpx;
  background: #f7f9fa;
  color: #1f2937;
}

.heading-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 26rpx;
}
.heading { color: #173c3a; font-size: 46rpx; font-weight: 700; line-height: 1.25; }
.sub { margin-top: 9rpx; color: #718087; font-size: 24rpx; line-height: 1.5; }

.rebuild,.upload,.delete,.empty-action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0;
  line-height: 1;
  text-align: center;
}
.rebuild {
  width: 136rpx;
  height: 62rpx;
  flex: 0 0 auto;
  margin: 0;
  border: 1rpx solid #a9d8d2;
  border-radius: 10rpx;
  background: #fff;
  color: #0f766e;
  font-size: 22rpx;
  white-space: nowrap;
}

.error {
  display: flex;
  padding: 18rpx 20rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #f4c7c2;
  border-radius: 12rpx;
  background: #fff3f2;
  color: #b91c1c;
  font-size: 23rpx;
  line-height: 1.5;
}

.upload-panel {
  padding: 24rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #c4e5e0;
  border-radius: 14rpx;
  background: #effaf8;
}
.upload-panel-top { display: flex; align-items: center; }
.upload-symbol {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #d4f0ec;
  color: #0f766e;
  font-size: 34rpx;
}
.upload-copy { min-width: 0; }
.upload-title { display: block; color: #1f4d48; font-size: 28rpx; font-weight: 700; }
.upload-note { display: block; margin-top: 6rpx; color: #6e8783; font-size: 22rpx; line-height: 1.45; }
.upload-rule { display: flex; justify-content: space-between; gap: 18rpx; margin-top: 20rpx; color: #6e8783; font-size: 21rpx; line-height: 1.4; }
.upload {
  width: 100%;
  height: 76rpx;
  margin-top: 20rpx;
  border-radius: 11rpx;
  background: #0f766e;
  color: #fff;
  font-size: 26rpx;
}
.upload[disabled] { background: #92bdb8; }

.progress-panel {
  padding: 20rpx 22rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e4ebed;
  border-radius: 14rpx;
  background: #fff;
}
.progress-label { display: flex; justify-content: space-between; margin-bottom: 13rpx; color: #53666b; font-size: 23rpx; }

.list-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 12rpx 4rpx; }
.list-title { display: block; color: #26383d; font-size: 29rpx; font-weight: 700; }
.list-note { display: block; margin-top: 5rpx; color: #95a2a7; font-size: 21rpx; }

.item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #e4ebed;
  border-radius: 14rpx;
  background: #fff;
}
.file-badge {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  background: #e8f5f3;
  color: #0f766e;
  font-size: 15rpx;
  font-weight: 700;
}
.item-main { min-width: 0; flex: 1; }
.name { overflow: hidden; color: #33454a; font-size: 27rpx; text-overflow: ellipsis; white-space: nowrap; }
.meta { margin-top: 6rpx; color: #94a1a6; font-size: 21rpx; }
.delete {
  width: 68rpx;
  height: 54rpx;
  flex: 0 0 auto;
  border: 1rpx solid #f4c7c2;
  border-radius: 10rpx;
  background: #fff;
  color: #b91c1c;
  font-size: 22rpx;
}

.empty {
  padding: 60rpx 18rpx;
  border: 1rpx dashed #c9d9d9;
  border-radius: 14rpx;
  background: #fff;
  text-align: center;
}
.empty-symbol { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; margin: 0 auto 12rpx; border-radius: 50%; background: #edf7f5; color: #0f766e; font-size: 32rpx; }
.empty-title { display: block; color: #53666b; font-size: 26rpx; font-weight: 600; }
.empty-copy { display: block; margin-top: 7rpx; color: #98a5aa; font-size: 22rpx; line-height: 1.5; }
.empty-action { height: 68rpx; margin: 18rpx auto 0; border: 1rpx solid #a9d8d2; border-radius: 10rpx; background: #fff; color: #0f766e; font-size: 24rpx; }
